        <!-- Đã thêm data-url và data-tab cho từng tab -->
        <ul class="nav nav-pills flex-column mb-auto" id="adminMenu">
            <li class="nav-item">
                <a href="#" data-tab="overview" data-url="/admin/overview" class="nav-link">
